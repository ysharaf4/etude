{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etude",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "etude-sync",
      "database_id": "9ffb6841-37a7-4560-a056-d6289a4c33f6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BLOBS",
      "id": "9aa8dd4457304d9eb22542c82b0aabb9"
    }
  ],
  "assets": {
    "directory": "./dist-browser",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
